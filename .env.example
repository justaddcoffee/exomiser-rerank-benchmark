# OpenScientist REST API the benchmark drives. Copy to `.env` and fill in.
# OS_API_KEY comes from the OS web UI -> "API Keys" page (format: name:secret).
OS_API_URL=http://localhost:8080
OS_API_KEY=name:secret

# Local OS only: path to OS's job-artifacts dir (its HOST_PROJECT_DIR/jobs), so the
# harness can read exomiser_ranking.json / reranked.json off disk after each job.
# e.g. /Users/you/PythonProject/shandy/jobs
OS_JOBS_DIR=

# Optional: cap concurrent in-flight jobs against the OS instance.
OS_MAX_INFLIGHT=2
